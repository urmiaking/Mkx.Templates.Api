{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mkx",
  "classifications": ["Web", "API", "ASP.NET Core"],
  "identity": "Mkx.Templates.Api",
  "name": "Mkx API Solution Template",
  "shortName": "mkx-api",
  "tags": { "language": "C#", "type": "solution" },
  "sourceName": "Mkx.Templates",
  "preferNameDirectory": false,
  "symbols": {
    "HttpPort": { "type": "generated", "generator": "port", "replaces": "7081" },
    "HttpsPort": { "type": "generated", "generator": "port", "replaces": "7082" }
  },
  "sources": [{
    "source": "./", "target": "./",
    "exclude": [
      "**/[Bb]in/**", "**/[Oo]bj/**", "**/TestResults/**", "**/.git/**", "**/.vs/**",
      "**/node_modules/**", "**/dist/**", "**/.dart_tool/**", "**/pubspec.lock",
      "**/*.user", "**/*.log", "**/appsettings.Local.json", "**/.env", "**/.env.*"
    ]
  }]
}
