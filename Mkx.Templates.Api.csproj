<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <TargetFramework>netstandard2.0</TargetFramework>
  <PackageType>Template</PackageType>
  <PackageId>Mkx.Templates.Api</PackageId>
  <PackageVersion>0.1.0</PackageVersion>
  <Title>Mkx API Solution Template</Title>
  <Authors>Mkx</Authors>
  <Description>.NET 10 backend-only solution template with Identity, JWT Bearer, rotated refresh tokens and EF Core.</Description>
  <PackageTags>dotnet-new;templates;api;net10;slnx</PackageTags>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <IncludeContentInPack>true</IncludeContentInPack>
  <IncludeBuildOutput>false</IncludeBuildOutput>
  <ContentTargetFolders>content</ContentTargetFolders>
  <NoDefaultExcludes>true</NoDefaultExcludes>
  <NoWarn>$(NoWarn);NU5110;NU5111;NU5128</NoWarn>
</PropertyGroup>
<ItemGroup>
  <None Include="README.md" Pack="true" PackagePath="/" />
  <Content Include="template-content/**/*" Exclude="template-content/**/bin/**;template-content/**/obj/**;template-content/**/TestResults/**;template-content/**/.vs/**;template-content/**/*.user;template-content/**/*.log;template-content/**/.env;template-content/**/.env.*" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  <Compile Remove="**/*" />
</ItemGroup>
</Project>
